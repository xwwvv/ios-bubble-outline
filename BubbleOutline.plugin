from base_plugin import BasePlugin, MethodHook
from hook_utils import find_class
from ui.settings import Header, Input, Switch

import threading
import os

try:
    from android.util import Log
    Log.d("tmessages", "[ios_bubble_outline] module import v1.0.3")
except Exception:
    pass

__id__ = "ios_bubble_outline"
__name__ = "iOS Bubble Outline"
__description__ = "Обводка пузырей в стиле iOS (DEX-версия)"
__author__ = "@xw_wvv"
__version__ = "1.0.3"
__icon__ = "exteraPlugins/1"
__app_version__ = ">=12.9.0"
__sdk_version__ = ">=1.4.4.3"

GITHUB_USER = "xwwvv"
GITHUB_REPO = "ios-bubble-outline"
DEX_URL = "https://raw.githubusercontent.com/{}/{}/main/outputs/bubble-outline.dex".format(
    GITHUB_USER, GITHUB_REPO
)
DEX_CLASS = "com.myplugin.outline.Main"
DEX_DIR = "ios_bubble_outline"
DEX_OPT_DIR = "ios_bubble_outline_opt"

DEFAULT_COLOR = "#000000"
DEFAULT_WIDTH = "1.5"
DEFAULT_OPACITY = "80"
DEFAULT_FORCE = False


class IosBubbleOutlinePlugin(BasePlugin):

    def _log(self, message):
        line = "[ios_bubble_outline] " + message
        try:
            self.log(line)
        except Exception:
            pass
        try:
            from android.util import Log
            Log.d("tmessages", line)
        except Exception:
            pass
        try:
            from org.telegram.messenger import ApplicationLoader
            pkg = ApplicationLoader.applicationContext.getPackageName()
            path = "/storage/emulated/0/Android/media/" + str(pkg) + "/ios_bubble_outline_debug.log"
            with open(path, "a") as fh:
                fh.write(line + "\n")
        except Exception:
            pass

    def on_plugin_load(self):
        try:
            self.outline_class = None
            self.hooked = False
            self._diag_done = False
            self._log("on_plugin_load started v1.0.3")
            data = self._fetch_dex()
            if data is None:
                self._log("Failed to fetch DEX")
                return
            clazz = self._load_dex(data)
            if clazz is None:
                self._log("Failed to load DEX class")
                return
            self.outline_class = clazz
            self._call_start()
            self._try_hook()
            if not self.hooked:
                threading.Thread(target=self._retry_hook, daemon=True).start()
        except Exception as e:
            self._log("Unexpected error: %s" % e)

    def _dex_cache_dir(self):
        from org.telegram.messenger import ApplicationLoader
        ctx = ApplicationLoader.applicationContext
        d = ctx.getDir(DEX_DIR, 0)
        return d.getAbsolutePath()

    def _dex_cache_path(self):
        return os.path.join(self._dex_cache_dir(), "bubble-outline-v2.dex")

    def _fetch_dex(self):
        import requests
        cache = self._dex_cache_path()
        try:
            if os.path.exists(cache):
                with open(cache, "rb") as fh:
                    data = fh.read()
                if data:
                    self._log("Using cached DEX (%d bytes)" % len(data))
                    return data
        except Exception as e:
            self._log("Cache read failed: %s" % e)
        try:
            resp = requests.get(DEX_URL, timeout=30)
            resp.raise_for_status()
            data = resp.content
            with open(cache, "wb") as fh:
                fh.write(data)
            self._log("DEX downloaded (%d bytes)" % len(data))
            return data
        except Exception as e:
            self._log("DEX download failed: %s" % e)
        return None

    def _load_dex(self, data):
        from org.telegram.messenger import ApplicationLoader
        from dalvik.system import InMemoryDexClassLoader, DexClassLoader
        from java.nio import ByteBuffer
        ctx = ApplicationLoader.applicationContext
        cache = self._dex_cache_path()
        try:
            buffer = ByteBuffer.wrap(data)
            loader = InMemoryDexClassLoader(buffer, ctx.getClassLoader())
            clazz = loader.loadClass(DEX_CLASS)
            self._log("DEX class loaded (in-memory)")
            return clazz
        except Exception as e:
            self._log("InMemory load failed: %s" % e)
        try:
            opt_dir = ctx.getDir(DEX_OPT_DIR, 0).getAbsolutePath()
            loader = DexClassLoader(cache, opt_dir, None, ctx.getClassLoader())
            clazz = loader.loadClass(DEX_CLASS)
            self._log("DEX class loaded (from file)")
            return clazz
        except Exception as e:
            self._log("File load failed: %s" % e)
        return None

    def _call_start(self):
        try:
            method = self.outline_class.getMethod("start")
            method.invoke(None)
            self._log("start() called")
        except Exception as e:
            self._log("start() failed: %s" % e)

    def _try_hook(self):
        try:
            cell_class = find_class("org.telegram.ui.Cells.ChatMessageCell")
            canvas_class = find_class("android.graphics.Canvas")
            method = cell_class.getDeclaredMethod("onDraw", canvas_class)
            method.setAccessible(True)
            self.hook_method(method, OutlineHook(self), 2147483647)
            self.hooked = True
            self._log("Hook registered")
        except Exception as e:
            self._log("Hook retry pending: %s" % e)

    def _retry_hook(self):
        import time
        for _ in range(30):
            if self.hooked:
                return
            time.sleep(1)
            try:
                self._try_hook()
            except Exception:
                pass

    def create_settings(self):
        return [
            Header(text="Bubble Outline"),
            Input(
                key="outline_color",
                text="Цвет обводки (HEX)",
                default=DEFAULT_COLOR,
                subtext="#RRGGBB",
                icon="msg_edit",
            ),
            Input(
                key="outline_width",
                text="Толщина (dp)",
                default=DEFAULT_WIDTH,
                icon="msg_edit",
            ),
            Input(
                key="outline_opacity",
                text="Непрозрачность (0-100)",
                default=DEFAULT_OPACITY,
                icon="msg_edit",
            ),
            Switch(
                key="force_everywhere",
                text="Форсировать везде",
                default=DEFAULT_FORCE,
                icon="msg_settings",
            ),
        ]

    def draw_outline(self, cell, canvas):
        if self.outline_class is None:
            return
        try:
            color = str(self.get_setting("outline_color", DEFAULT_COLOR))
            width = float(self.get_setting("outline_width", DEFAULT_WIDTH))
            opacity = int(self.get_setting("outline_opacity", DEFAULT_OPACITY))
            force = bool(self.get_setting("force_everywhere", DEFAULT_FORCE))
            method = self.outline_class.getDeclaredMethod(
                "drawOutline",
                find_class("java.lang.Object"),
                find_class("android.graphics.Canvas"),
                find_class("java.lang.String"),
                find_class("java.lang.Float"),
                find_class("java.lang.Integer"),
                find_class("java.lang.Boolean"),
            )
            method.invoke(None, cell, canvas, color, width, opacity, force)
        except Exception as e:
            if not self._diag_done:
                self._diag_done = True
                self._log("drawOutline error: %s" % e)


class OutlineHook(MethodHook):

    def __init__(self, plugin):
        self.plugin = plugin

    def after_hooked_method(self, param):
        self.plugin.draw_outline(param.thisObject, param.args[0])